# Copy to .env and fill in values. Pydantic reads these (case-insensitive names).

API_CORS_ALLOW_ORIGIN=*

UPLOADS_ROOT=./data/uploads
OUTPUTS_ROOT=./data/outputs

# Max video upload size; each unit is 1024×1024 bytes (e.g. 1024 ≈ 1 GiB)
MAX_UPLOAD_MB=1024

# Optional: full path if ffmpeg is not on PATH (Windows example):
# FFMPEG_BIN=C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_BIN=

# LLM provider (gemini | ollama). For local Gemma: set LLM_PROVIDER=ollama and run Ollama.
LLM_PROVIDER=gemini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:2b

GEMINI_API_KEY=
# Model id for multi-agent reasoning (e.g. gemini-2.0-flash or gemini-1.5-flash)
GEMINI_AGENT_MODEL=gemini-2.0-flash

# Prefer Vertex AI (aiplatform.googleapis.com) via Application Default Credentials (ADC).
# If enabled, the backend will create the client with vertexai=True and use GCP_PROJECT/GCP_LOCATION.
GEMINI_USE_VERTEXAI=false
GCP_PROJECT=
GCP_LOCATION=us-central1
# Bumps cache keys when prompts change
AGENT_PROMPT_VERSION=v1
REFINEMENT_MAX_ITERATIONS=3
REFINEMENT_QUALITY_THRESHOLD=0.78
REFINEMENT_QUALITY_EPSILON=0.02

# medium/large = better quality; base/tiny = much faster on CPU for dev
WHISPER_MODEL_NAME=medium
# cuda:0 when CTranslate2 has a working NVIDIA stack; use cpu if you see "unsupported device cuda"
GPU_DEVICE=cuda:0

# Use at least 32 random bytes/characters in production
AUTH_SECRET=dev-change-me-dev-change-me-dev-change-me-2026
AUTH_TOKEN_TTL_SECONDS=1209600
