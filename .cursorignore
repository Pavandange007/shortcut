# Keep Cursor's indexer / AI context away from huge trees (reduces RAM spikes and IDE instability).
# If you need to debug a library, open it outside the workspace or temporarily remove a line here.

**/node_modules/
**/.venv/
**/venv/

frontend/.next/
frontend/out/
frontend/.turbo/

backend/**/__pycache__/
backend/**/*.py[cod]
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/

# Large local uploads and generated media
backend/data/
